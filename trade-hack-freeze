-- Қол жеткізу (Remotes)
local Net = game:GetService("ReplicatedStorage").Packages.Net
local ReadyEvent = Net["RE/TradeService/Ready"]
local RemoveFunction = Net["RF/TradeService/RemoveBrainrot"]

local _G = { Freeze = false, AntiKick = true }

-- --- FUNCTIONS ---

Tabs.Trade:AddToggle("FreezeToggle", {Title = "Ghost Freeze (Scam)", Default = false }):OnChanged(function(Value)
    _G.Freeze = Value
    Fluent:Notify({
        Title = "VIP STATUS",
        Content = Value and "Freeze ҚОСЫЛДЫ! Затты алып таста." or "Freeze ӨШТІ.",
        Duration = 5
    })
end)

Tabs.Trade:AddButton({
    Title = "Instant Ready",
    Callback = function()
        ReadyEvent:FireServer()
    end
})

Tabs.Settings:AddToggle("KickToggle", {Title = "Anti-Kick Protection", Default = true }):OnChanged(function(Value)
    _G.AntiKick = Value
end)

-- --- HOOKING LOGIC ---
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if _G.AntiKick and method == "Kick" then return nil end
    if _G.Freeze and self == RemoveFunction and (method == "InvokeServer" or method == "FireServer") then
        return wait(9e9) 
    end

    return old(self, unpack(args))
end)

setreadonly(mt, true)
Window:SelectTab(1)
