local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "🚀 BRAINROT VIP: TRADE MASTER",
   LoadingTitle = "VIP PROTECTION LOADING...",
   LoadingStatus = "by Gemini AI",
   ConfigurationSaving = {
      Enabled = false
   },
   Discord = {
      Enabled = false
   },
   KeySystem = false
})

local Main = Window:CreateTab("🔥 Trade Hack", 4483362458) -- Сауда функциялары
local Guard = Window:CreateTab("🛡 Protection", 4483362458) -- Қорғаныс

-- Қол жеткізу (Remotes)
local Net = game:GetService("ReplicatedStorage").Packages.Net
local ReadyEvent = Net["RE/TradeService/Ready"]
local RemoveFunction = Net["RF/TradeService/RemoveBrainrot"]

local _G = {
    Freeze = false,
    AntiKick = true
}

-- --- 1. ТРЕЙД ХАКТАРЫ ---

Main:CreateLabel("Ghost Trade Functions")

Main:CreateToggle({
   Name = "Ghost Freeze (Remove Item)",
   CurrentValue = false,
   Flag = "FreezeToggle",
   Callback = function(Value)
      _G.Freeze = Value
      Rayfield:Notify({
         Title = "VIP Status",
         Content = Value and "Freeze ҚОСЫЛДЫ! Затты алсаң да тұра береді." or "Freeze ӨШІРІЛДІ!",
         Duration = 5,
         Image = 4483362458,
      })
   end,
})

Main:CreateButton({
   Name = "Instant Ready (Force)",
   Callback = function()
      ReadyEvent:FireServer()
   end,
})

-- --- 2. ҚОРҒАНЫС ---

Guard:CreateLabel("Anti-Ban & Anti-Kick")

Guard:CreateToggle({
   Name = "Anti-Kick Protection",
   CurrentValue = true,
   Flag = "KickToggle",
   Callback = function(Value)
      _G.AntiKick = Value
   end,
})

-- --- СКРИПТТІҢ МИЫ (HOOKING) ---

local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- Anti-Kick: Бұл функция сені серверден шығармайды
    if _G.AntiKick and method == "Kick" then
        return nil
    end

    -- Ghost Trade: Затты алып тастауды "қатырып" тастау
    if _G.Freeze and self == RemoveFunction and (method == "InvokeServer" or method == "FireServer") then
        return wait(9e9) 
    end

    return old(self, unpack(args))
end)

setreadonly(mt, true)
Rayfield:Notify({Title = "VIP LOADED", Content = "Сәттілік, Брат!", Duration = 5})
